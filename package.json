{
  "name": "@kubohiroya/turbowarp-ar",
  "version": "0.5.0",
  "description": "A TurboWarp extension for camera-source based AR target state.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-ar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-ar.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-ar/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "ar",
    "camera",
    "camera-source",
    "vite",
    "typescript"
  ],
  "type": "module",
  "exports": {
    "./plan": {
      "types": "./dist/plan.d.ts",
      "import": "./dist/plan.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets/",
    "dist/",
    "docs/",
    "src/",
    "templates/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "schemas/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts && node scripts/generate-fixed-input-docs.mjs",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md",
    "template:readme": "node scripts/apply-readme-template.ts",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-camera-source": "^0.20.0",
    "@kubohiroya/turbowarp-extension-manifest": "^0.3.2",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.8.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "react-dom": "18.3.1",
    "@kubohiroya/turbowarp-extension-data-editor": "^0.3.4"
  },
  "gitHead": "0d616d6361eade6043af243aa568ba4a2d308482",
  "x-turbowarp-source": {
    "revision": "0d616d6361eade6043af243aa568ba4a2d308482",
    "revisionRole": "base-commit",
    "sourceState": "local-release-overlay"
  }
}
